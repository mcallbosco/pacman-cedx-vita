<?xml version="1.0" encoding="utf-8"?>

<livearea style="a1" format-ver="01.00" content-rev="@VITA_LIVEAREA_CONTENT_REV@">
	<livearea-background>
		<image>bg0.png</image>
	</livearea-background>

	<gate>
		<startup-image>startup.png</startup-image>
	</gate>

	<frame id="frame2">
		<liveitem>
			<target>psla:-config</target>
			<text origin="background" align="center" line-align="center" text-valign="center">
				<str size="22" bold="on" shadow="on" color="#ffffff">Settings</str>
			</text>
		</liveitem>
	</frame>

	<frame id="frame3">
		<liveitem>
			<text origin="background" align="center" line-align="center" text-valign="bottom" margin-bottom="18" ellipsis="off">
				<str size="20" bold="on" shadow="on" color="#ffffff">@VITA_LIVEAREA_CREDIT_TEXT@</str>
			</text>
		</liveitem>
	</frame>
</livearea>
